// `mind.lock`: what the dependency graph resolved to, written down.
//
// A tag can be moved and a branch always moves, so "json at v1.0" is not the
// same bytes on every machine that asks. The lock records, for every package
// every program in the build resolved to, where it came from, which version
// it said it was, for a git dependency the commit that was checked out, and
// for anything fetched the hash of what arrived (fetch.dr's tree hash). A
// later build that resolves to a different commit or different contents from
// the same place stops and says so, rather than quietly building something
// else; `mind update` is how the lock is told to move.
//
// The commit and the hash are both kept because they catch different things.
// A commit is git's word for what it checked out, and a moved tag shows up
// there first, in terms anyone can look up. The hash is the bytes, and it is
// the only one a tarball, a mirror or a hand-edited cache can be held to.
//
// The lock is also what remembers trust (sign.dr): the key that signed each
// package, the keys the project named for it when it did, and the keys that
// have been rotated away; and, in a `[revoked]` section of its own, every key
// a package has been seen to revoke. A statement in a package is only there
// for as long as whoever serves the package leaves it in, so what one has
// once said is written here, where it outlives the package that said it.
//
// A program's packages and each build script's are separate namespaces, so the
// lock has a section for each: `[program]`, `[build]` for this project's
// script, and `[build.KEY]` for a dependency's. Each package is one line, an
// inline table under its key, because `std.toml` reads no `[[array]]` headers
// and a line per package diffs well.
//
// The file is written by hand rather than through `toml.encode`, sorted by
// section and then key: a lock that reorders itself when nothing changed is
// noise in every commit. It is only written when its text changes.
//
// This module is pure but for reading and writing the file; what the entries
// are is `build.dr`'s business.

import std.file;
import std.list;
import std.path;
import std.str;
import std.toml;

import std.map;

/// One package as the lock records it, or one revoked key (`section` is
/// `revoked`, `key` the key, `source` where it was seen). Every field but the
/// first three may be absent: a path dependency has no commit, hash or
/// signer, a bare directory no version, and a lock from before a field was
/// recorded does not have it.
mapping Entry {
    section : :string
    key : :string
    source = ()
    commit = ()
    version = ()
    hash = ()
    signer = ()
    // The keys the project named for it when `signer` was recorded, spelled
    // and sorted: when they change, the project has chosen to trust anew.
    keys = []
    retired = []
}

/// The section revocations are kept in.
let revoked_section = "revoked";

let file_name = "mind.lock";

let header = "# What this project's dependencies resolved to. Written by `mind`;\n"
             + "# `mind update` moves it. Commit it with the manifest.\n";

/// Sorted by section, `program` first and `revoked` last, then by key.
let sorted : [Entry] -> [Entry];
let sorted entries = {
    let rank e = match Entry.section e { "program" => 0, s if s == revoked_section => 2, _ => 1 };
    list.sort_on (fn e -> [rank e, Entry.section e, Entry.key e]) entries
};

let field name v = match v { () => [], x => [name + " = " + toml.quote (to_string x)] };

let list_field name vs = match vs {
    [] => [],
    xs => [name + " = [" + str.join_str ", " (list.map (fn x -> toml.quote (to_string x)) xs) + "]"],
};

let line : Entry -> :string;
let line e =
    toml.quote (Entry.key e) + " = { "
    + str.join_str ", " (list.concat [field "source" (Entry.source e), field "version" (Entry.version e),
                                      field "commit" (Entry.commit e), field "hash" (Entry.hash e),
                                      field "signer" (Entry.signer e), list_field "keys" (Entry.keys e),
                                      list_field "retired" (Entry.retired e)])
    + " }";

/// The file's text.
let render : [Entry] -> :string;
let render entries = {
    let rec go es current acc =
        match es {
            [] => acc,
            [e, ..rest] => {
                let head = if Entry.section e == current { [] }
                           else { ["", "[" + Entry.section e + "]"] };
                go rest (Entry.section e) (list.concat [acc, head, [line e]])
            },
        };
    header + str.join_str "\n" (go (sorted entries) () []) + "\n"
};

/// The entries a lock file holds, or `[]` for one that cannot be read -- a
/// broken lock is rewritten rather than trusted.
let parse : :string -> [Entry];
let parse text =
    match toml.parse text {
        Result.ok(doc) => list.concat (map (fn pair -> {
            let [section, table] = pair;
            map (fn kv -> {
                let [key, v] = kv;
                let get k = if type_of v == :map { v.[k else ()] } else { () };
                let many k = match get k { () => [], xs if type_of xs == :list => xs, x => [x] };
                Entry.make section key (get "source") (get "commit") (get "version") (get "hash") (get "signer")
                           (many "keys") (many "retired")
            }) (map.pairs table)
        }) (filter (fn pair -> list.head pair != "") (map.pairs doc))),
        _ => [],
    };

/// The packages, without the revocations.
let packages : [Entry] -> [Entry];
let packages entries = list.filter (fn e -> Entry.section e != revoked_section) entries;

/// The keys revoked, as spelled.
let revoked : [Entry] -> [:string];
let revoked entries = list.map Entry.key (list.filter (fn e -> Entry.section e == revoked_section) entries);

/// A revocation, as an entry.
let revocation : :string -> :string -> Entry;
let revocation key seen = (Entry.new revoked_section key) |> Entry.set_source seen;

/// Every package that resolved to a different commit, or different contents,
/// from the same source as the lock says: the one change a lock exists to
/// catch. A changed source is the manifest being edited, which is somebody's
/// decision, so it is not one. Something the lock does not record yet -- a
/// hash in a lock from before them -- is learned, not compared.
let drift : [Entry] -> [Entry] -> [Entry];
let drift old new = {
    let at e = Entry.section e + "\n" + Entry.key e;
    let before = fold (fn m e -> m.[at e => e]) (%{}) (packages old);
    let differ a b = a != () && b != () && a != b;
    filter (fn e -> match before.[at e else ()] {
        () => false,
        o => Entry.source o == Entry.source e
             && (differ (Entry.commit o) (Entry.commit e) || differ (Entry.hash o) (Entry.hash e)),
    }) (packages new)
};

/// What the lock says about each fetched source, `source => entry`: the bytes
/// a fetch may take from a mirror or the store in place of the source, and
/// who it trusted to sign them.
let by_source : [Entry] -> %{ :string => Entry };
let by_source entries =
    fold (fn m e -> match Entry.source e { () => m, s => m.[s => e] }) (%{}) (packages entries);

/// What the lock says about each package by the key it is imported as, the
/// program's entry first when a build script has one by the same key: what
/// trust is remembered by, since a release moves the source along with its tag.
let by_key : [Entry] -> %{ :string => Entry };
let by_key entries =
    fold (fn m e -> if map.has (Entry.key e) m { m } else { m.[Entry.key e => e] }) (%{}) (sorted (packages entries));

/// What the lock says about one package, for the message about it.
let locked : [Entry] -> Entry -> Entry | :unit;
let locked old e =
    match list.filter (fn o -> Entry.section o == Entry.section e && Entry.key o == Entry.key e) old {
        [o, .._] => o,
        [] => (),
    };

/// A walk that did not see everything -- a build without dev dependencies --
/// keeps the entries it did not see, so building and testing do not rewrite
/// the lock back and forth. A full walk (`complete`) replaces it. Either way
/// a revocation is never forgotten.
let merge : [Entry] -> [Entry] -> :bool -> [Entry];
let merge old new complete = {
    let at e = Entry.section e + "\n" + Entry.key e;
    let seen = fold (fn m e -> m.[at e => true]) (%{}) new;
    let kept = if complete { list.filter (fn o -> Entry.section o == revoked_section) old } else { old };
    list.append new (filter (fn o -> not (seen.[at o else false])) kept)
};

let load! root = match file.read! (path.join root file_name) { Option.none => [], Option.some(text) => parse text };

/// Write the lock, if it changed. A lock that would record nothing is not
/// created where there was none: a project with no dependencies, or a lone
/// file run by `mind run hello.dr`, has nothing to pin, and a file appearing
/// beside it would only be something to delete.
let save! root entries = {
    let path = path.join root file_name;
    let text = render entries;
    match file.read! path {
        Option.none => if list.is_empty entries { () } else { file.write! path text },
        Option.some(old) => if old == text { () } else { file.write! path text },
    }
};

when test {
    import std.test;

    let a = Entry.make "program" "json" "https://x/json#v1" "abc" "1.0.0" "sha256:01" "ed25519:aa" ["ed25519:aa"] [];
    let b = Entry.new "build" "gen" |> Entry.set_source "../gen" |> Entry.set_version "0.2.0";
    let r = revocation "ed25519:bb" "https://x/json#v1";
    let keys es = list.map (fn e -> [Entry.section e, Entry.key e]) es;

    let tests = [
        test.case "a lock is sections of one line per package, sorted, revocations last"
            $( test.eq! (header + "\n[program]\n\"json\" = { source = \"https://x/json#v1\", version = \"1.0.0\", commit = \"abc\", hash = \"sha256:01\", signer = \"ed25519:aa\", keys = [\"ed25519:aa\"] }\n\n[build]\n\"gen\" = { source = \"../gen\", version = \"0.2.0\" }\n\n[revoked]\n\"ed25519:bb\" = { source = \"https://x/json#v1\" }\n")
                        (render [r, b, a]) ),
        test.case "a lock reads back as what was written"
            $( test.eq! (sorted [a, b, r]) (sorted (parse (render [a, b, r]))) ),
        test.case "a new commit from the same source is drift"
            $( test.eq! [["program", "json"]] (keys (drift [a, b] [Entry.set_commit "def" a, b])) ),
        test.case "new contents at the same commit are drift"
            $( test.eq! 1 (list.length (drift [a] [Entry.set_hash "sha256:02" a])) ),
        test.case "a hash the lock did not have yet is learned"
            $( test.eq! [] (drift [Entry.set_hash () a] [a]) ),
        test.case "a new source is an edit, not drift"
            $( test.eq! [] (drift [a] [a |> Entry.set_source "https://x/json#v2" |> Entry.set_hash "sha256:02"]) ),
        test.case "the lock is found again by source"
            $( test.eq! ["../gen", "https://x/json#v1"] (list.sort (map.keys (by_source [a, b, r]))) ),
        test.case "revocations are kept apart from packages"
            $( test.eq! [["ed25519:bb"], 2] [revoked [a, r, b], list.length (packages [a, r, b])] ),
        test.case "a partial walk keeps what it did not see"
            $( test.eq! [["program", "json"], ["build", "gen"]] (keys (merge [a, b] [a] false)) ),
        test.case "a complete walk replaces the packages, and never forgets a revocation"
            $( test.eq! [["program", "json"], ["revoked", "ed25519:bb"]] (keys (merge [a, b, r] [a] true)) ),
    ];
}
