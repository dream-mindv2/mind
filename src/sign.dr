// Signed releases.
//
// A hash in `mind.lock` protects a version you have already fetched: the
// next fetch of it must be the same bytes. It says nothing about a version
// you are fetching for the first time, which is whatever the host serves.
// A signature does. A dependency that lists `keys` in its manifest entry
//
//     json = { git = "https://github.com/u/json", tag = "v1.4", keys = ["ed25519:3d40.."] }
//
// -- or that the root's `[trust]` names keys for -- is only used when it
// carries a signature by one of them over the bytes that arrived, so a host,
// a mirror, or anyone between can serve a release only its author signed.
//
// **What is signed** is the tree hash (fetch.dr), the one already in the lock,
// and the name of the release, behind a line saying what the message is
// (`release_message`), so that a key used here signs nothing that could be
// taken for something else. The release's name is what stops an old signed
// release from being served in place of a new one: a dependency pinned to
// tag `v1.4` needs a signature *of* `v1.4`, and `v1.0`'s does not do.
//
// The signatures are a file in the package, `mind.sig`, one statement per
// line, and the tree hash leaves that file out: adding one changes nothing it
// signs, and it travels with the bytes through git, a tarball and a mirror.
// There are three statements, each signed by the key it is about:
//
//     release ed25519:KEY v1.4 sha256:HASH SIG    KEY made these bytes as v1.4
//     rotate ed25519:OLD ed25519:NEW SIG          OLD hands over to NEW
//     revoke ed25519:KEY SIG                      KEY is not to be trusted again
//     build ed25519:KEY v1.4 SOURCE COMPILER STD VM PROFILE IMAGE SIG
//                                                 built from SOURCE by COMPILER
//                                                 with STD on VM as PROFILE, it
//                                                 is IMAGE
//
// The last is a build attestation (`mind attest`): every part of it is a
// hash, so anyone holding the same source, compiler and standard library can
// rebuild and compare (`mind reproduce`), which is what says a published image
// came from the published source and nothing else. Builds are byte for byte
// reproducible once the paths they record are made relative
// (`--remap-path-prefix`), so a mismatch is a finding, not noise.
//
// **Who is trusted** (`decide`) starts from the keys the manifest names and
// the key the lock last saw sign the package, follows each through any
// rotations, and leaves out every key that has been rotated away or revoked.
// A rotation and a revocation are both *remembered* -- the lock keeps the
// retired keys and the signer, `$MIND_HOME/revoked` and the lock keep the
// revoked ones -- because a statement is only in the packages that carry it,
// and whoever holds the old key can serve a package without it. A dependency
// that names no key is still pinned to its first signer, if it has one: from
// then on it is held to that key, which is what covers the dependencies of
// dependencies that nobody listed a key for.
//
// **Keys are Ed25519** (`std.crypto`), written `ed25519:` and 64 hex digits,
// and held here as their 32 bytes. A secret key is a file holding its seed in
// hex; `mind keygen` makes one, and nothing here prints it.
//
// This module is pure. Reading the files is the caller's.

import std.crypto;
import std.list;
import std.str;

/// The file a package's signatures are in, at its root.
let file_name = "mind.sig";

let algorithm = "ed25519:";

let header = "# Signed statements about this package, one per line. Written by `mind sign`, `rotate` and `revoke`.";

// --- keys ----------------------------------------------------------------------------

/// A key as written, `ed25519:HEX`, to its 32 bytes, or `()` for text that is
/// not one. Either case of hex reads; it is written lowercase.
let key_bytes : :string -> :string | :unit;
let key_bytes text =
    match str.starts_with algorithm text {
        false => (),
        true => match crypto.unhex (str.trim_prefix algorithm text) {
            () => (),
            b => if str.byte_length b == 32 { b } else { () },
        },
    };

/// How a key is written.
let spell : :string -> :string;
let spell bytes = algorithm + crypto.hex bytes;

/// A manifest's `keys`, which may be one string or a list of them.
let listed : :any -> [:string];
let listed v = match v { () => [], s if type_of s == :string => [s], ks => map to_string ks };

// --- statements ------------------------------------------------------------------------

/// One line of `mind.sig`, keys and signature as bytes.
union Statement {
    release(key : :string, name : :string, hash : :string, signature : :string),
    rotate(old : :string, new : :string, signature : :string),
    revoke(key : :string, signature : :string),
    build(key : :string, name : :string, built : Built, signature : :string),
}

/// What a build attestation says: the hashes of what went in and what came out.
mapping Built {
    source : :string
    compiler : :string
    std : :string
    // The VM the compiler ran on, `0.1.0+COMMIT` as `dream --version` names it.
    // Not a hash: the same VM built twice is two binaries, and what matters
    // is which source it was built from.
    vm : :string
    profile : :string
    image : :string
}

let release_message : :string -> :string -> :string;
let release_message name h = "mind-release-v2\nrelease " + name + "\nhash " + h + "\n";

let rotate_message : :string -> :string -> :string;
let rotate_message old new = "mind-rotate-v1\nfrom " + spell old + "\nto " + spell new + "\n";

let build_message : :string -> Built -> :string;
let build_message name b =
    "mind-build-v1\nrelease " + name + "\nsource " + Built.source b + "\ncompiler " + Built.compiler b
    + "\nstd " + Built.std b + "\nvm " + Built.vm b + "\nprofile " + Built.profile b + "\nimage " + Built.image b + "\n";

let revoke_message : :string -> :string;
let revoke_message key = "mind-revoke-v1\nkey " + spell key + "\n";

/// The statements a seed makes.
let release : :string -> :string -> :string -> Statement;
let release seed name h = {
    let key = crypto.ed25519_public seed;
    Statement.release key name h (crypto.ed25519_sign seed (release_message name h))
};

let rotate : :string -> :string -> Statement;
let rotate old_seed new_key = {
    let old = crypto.ed25519_public old_seed;
    Statement.rotate old new_key (crypto.ed25519_sign old_seed (rotate_message old new_key))
};

let attest : :string -> :string -> Built -> Statement;
let attest seed name b = {
    let key = crypto.ed25519_public seed;
    Statement.build key name b (crypto.ed25519_sign seed (build_message name b))
};

let revoke : :string -> Statement;
let revoke seed = {
    let key = crypto.ed25519_public seed;
    Statement.revoke key (crypto.ed25519_sign seed (revoke_message key))
};

/// Whether the statement's signature is its key's.
let valid : Statement -> :bool;
let valid s = match s {
    Statement.release(k, n, h, sig) => crypto.ed25519_verify k (release_message n h) sig,
    Statement.rotate(old, new, sig) => crypto.ed25519_verify old (rotate_message old new) sig,
    Statement.revoke(k, sig) => crypto.ed25519_verify k (revoke_message k) sig,
    Statement.build(k, n, b, sig) => crypto.ed25519_verify k (build_message n b) sig,
};

let render : Statement -> :string;
let render s = match s {
    Statement.release(k, n, h, sig) => "release " + spell k + " " + n + " " + h + " " + crypto.hex sig,
    Statement.rotate(old, new, sig) => "rotate " + spell old + " " + spell new + " " + crypto.hex sig,
    Statement.revoke(k, sig) => "revoke " + spell k + " " + crypto.hex sig,
    Statement.build(k, n, b, sig) => str.join_str " " ["build", spell k, n, Built.source b, Built.compiler b,
                                                       Built.std b, Built.vm b, Built.profile b, Built.image b, crypto.hex sig],
};

/// One line read, or none for a comment, a blank, or a line of the wrong
/// shape -- which is skipped rather than fatal, so that one bad line cannot
/// hide a good one below it.
let parse_line : :string -> Option Statement;
let parse_line line =
    match str.words line {
        ["release", k, n, h, s] => match [key_bytes k, crypto.unhex s] {
            [(), _] => Option.none,
            [_, ()] => Option.none,
            [kb, sb] => Option.some (Statement.release kb n h sb),
        },
        ["rotate", old, new, s] => match [key_bytes old, key_bytes new, crypto.unhex s] {
            [(), _, _] => Option.none,
            [_, (), _] => Option.none,
            [_, _, ()] => Option.none,
            [ob, nb, sb] => Option.some (Statement.rotate ob nb sb),
        },
        ["revoke", k, s] => match [key_bytes k, crypto.unhex s] {
            [(), _] => Option.none,
            [_, ()] => Option.none,
            [kb, sb] => Option.some (Statement.revoke kb sb),
        },
        ["build", k, n, source, compiler, std, vm, profile, image, s] => match [key_bytes k, crypto.unhex s] {
            [(), _] => Option.none,
            [_, ()] => Option.none,
            [kb, sb] => Option.some (Statement.build kb n (Built.make source compiler std vm profile image) sb),
        },
        _ => Option.none,
    };

/// Every statement in a signature file that its own key signed. One that does
/// not verify is as good as absent: anyone can write a line.
let statements : :string -> [Statement];
let statements text =
    list.filter valid (list.flat_map (fn l -> match parse_line l { Option.some(s) => [s], Option.none => [] })
                                     (str.split "\n" text));

/// Two statements are the same slot when a newer one should replace the
/// older: a key's release, a key's rotation, a key's revocation.
let slot : Statement -> [:any];
let slot s = match s {
    Statement.release(k, _, _, _) => [:release, k],
    Statement.rotate(old, _, _) => [:rotate, old],
    Statement.revoke(k, _) => [:revoke, k],
    Statement.build(k, _, b, _) => [:build, k, Built.profile b],
};

/// The build attestations among some statements, as `[key, release, built]`.
let builds : [Statement] -> [[:any]];
let builds ss = list.flat_map (fn s -> match s { Statement.build(k, n, b, _) => [[k, n, b]], _ => [] }) ss;

/// A signature file with `s` in it, replacing what filled its slot and keeping
/// everything else, comments included: signing v1.5 drops this key's v1.4
/// line and keeps another key's, and a rotation or revocation stays in every
/// release after it, which is how users who skipped one still hear of it.
let with_statement : :string -> Statement -> :string;
let with_statement text s = {
    let kept = list.filter (fn l -> match parse_line l {
        Option.some(old) => slot old != slot s,
        Option.none => not (str.is_empty (str.trim l)),
    }) (str.split "\n" text);
    let body = match kept { [] => [header], ks => ks };
    str.join_str "\n" (list.append body [render s]) + "\n"
};

// --- deciding --------------------------------------------------------------------------

/// What `decide` is told about one dependency: the keys the project names for
/// it (`roots`); what the lock remembers -- the key that signed it last and the
/// keys it has seen retired, `()` and `[]` when the lock says nothing or
/// trusted other roots; every key known to be revoked; the release it must be
/// signed as, when it is pinned to a tag; and whether being unsigned is an
/// error even with no key named. Keys are bytes.
mapping Policy {
    roots = []
    signer = ()
    retired = []
    revoked = []
    release = ()
    required = false
}

/// What `decide` answers: the key that signed it (`()` for an unsigned
/// package nobody required to be signed), the keys retired for it now, and
/// the revocations it carried, for the caller to remember.
mapping Verdict {
    signer = ()
    retired = []
    revoked = []
}

/// A key followed through the rotations it and its successors made. A cycle
/// stops where it would repeat.
let latest : [[:string]] -> :string -> :string;
let latest rotations key = {
    let rec go k seen =
        match list.filter (fn pair -> list.head pair == k) rotations {
            [[_, next], .._] if not (list.contains next seen) => go next (list.cons next seen),
            _ => k,
        };
    go key [key]
};

let spelled keys = str.join_str ", " (list.map spell keys);

/// Whether a package that hashes to `h` and carries `text` (its signature
/// file, `()` for none) may be used under `p`. The error says which way it
/// failed, since "unsigned", "someone else's", "other bytes" and "another
/// release" each want a different fix.
let decide : Policy -> :string -> (:string | :unit) -> Result Verdict :string;
let decide p h text = {
    let ss = match text { () => [], t => statements t };
    let rotations = list.flat_map (fn s -> match s { Statement.rotate(old, new, _) => [[old, new]], _ => [] }) ss;
    let revocations = list.flat_map (fn s -> match s { Statement.revoke(k, _) => [k], _ => [] }) ss;
    let releases = list.flat_map (fn s -> match s { Statement.release(k, n, lh, _) => [[k, n, lh]], _ => [] }) ss;
    let revoked = list.unique (list.append (Policy.revoked p) revocations);
    let retired = list.unique (list.append (Policy.retired p) (list.map list.head rotations));
    let starts = list.append (Policy.roots p) (match Policy.signer p { () => [], s => [s] });
    let usable k = not (list.contains k revoked) && not (list.contains k retired);
    let trusted = list.filter usable (list.unique (list.map (latest rotations) starts));
    let as_wanted n = match Policy.release p { () => true, w => n == w };
    let answer signer = Result.ok (Verdict.make signer retired revocations);
    let by_trusted = list.filter (fn r -> list.contains (list.head r) trusted) releases;
    let fits = list.filter (fn r -> list.nth 2 r == h && as_wanted (list.nth 1 r)) by_trusted;
    match [starts, trusted, fits] {
        // Nobody named a key and the lock has none: the first signer, if there
        // is one, becomes the one to hold it to.
        [[], _, _] => match list.filter (fn r -> list.nth 2 r == h && as_wanted (list.nth 1 r)
                                                 && not (list.contains (list.head r) revoked)) releases {
            [[k, _, _], .._] => answer k,
            _ => if Policy.required p {
                Result.error ("is not signed by a key this project trusts, and [fetch] require-signatures is set: "
                              + "name its author's key in its entry or in [trust]")
            } else { answer () },
        },
        [_, [], _] => Result.error ("may only be signed by " + spelled (list.unique starts)
                                    + ", and every one of them has been revoked or rotated away"),
        [_, _, [[k, _, _], .._]] => answer k,
        _ => match [text, by_trusted, list.filter (fn r -> list.nth 2 r == h) by_trusted] {
            [(), _, _] => Result.error ("is not signed (it has no " + file_name + "), but must be by " + spelled trusted),
            [_, [], _] => Result.error ("is not signed by " + spelled trusted
                                        + (if list.is_empty releases { "" }
                                           else { " (it is signed by " + spelled (list.unique (list.map list.head releases)) + ")" })),
            [_, _, [[_, n, _], .._]] => Result.error ("is signed as release " + n + ", not " + to_string (Policy.release p)
                                                      + " -- an older release served in place of the one asked for?"),
            [_, [[_, _, lh], .._], _] => Result.error ("is signed as " + lh + ", but what arrived hashes to " + h),
            _ => Result.error "is not signed as it must be",
        },
    }
};

when test {
    import std.test;

    let seed = crypto.unhex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb";
    let other = crypto.unhex "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7";
    let third = crypto.unhex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60";
    let pub = crypto.ed25519_public seed;
    let pub2 = crypto.ed25519_public other;
    let pub3 = crypto.ed25519_public third;
    let h = "sha256:" + str.repeat 64 "a";
    let file ss = list.fold (fn t s -> with_statement t s) "" ss;
    let signed = file [release seed "v1" h];
    let trusting keys = Policy.set_roots keys (Policy.new ());
    let error_of r = match r { Result.error(why) => why, Result.ok(_) => "ok" };
    let says text r = str.find text (error_of r) >= 0;
    let signer_of r = match r { Result.ok(v) => Verdict.signer v, _ => :refused };

    let tests = [
        test.case "a key is ed25519: and 32 bytes of hex"
            $( test.eq! [pub, pub, (), (), ()]
                        [key_bytes (spell pub), key_bytes ("ed25519:" + str.upper (crypto.hex pub)),
                         key_bytes "ed25519:abcd", key_bytes ("rsa:" + crypto.hex pub),
                         key_bytes ("ed25519:" + str.repeat 64 "z")] ),
        test.case "keys may be one or several"
            $( test.eq! [["a"], ["a", "b"], []] [listed "a", listed ["a", "b"], listed ()] ),
        test.case "every statement reads back as written, and verifies"
            $( test.eq! 3 (list.length (statements (file [release seed "v1" h, rotate seed pub2, revoke other]))) ),
        test.case "a statement whose signature is not its key's is as good as absent"
            $( test.eq! [] (statements (str.replace (spell pub) (spell pub2) signed)) ),
        test.case "a trusted signature over the hash passes, and names its key"
            $( test.eq! pub (signer_of (decide (trusting [pub]) h signed)) ),
        test.case "no signature file is said to be"
            $( test.eq! true (says "has no mind.sig" (decide (trusting [pub]) h ())) ),
        test.case "a signature by someone else is said to be"
            $( test.eq! true (says "is not signed by" (decide (trusting [pub2]) h signed)) ),
        test.case "other bytes than were signed are said to be"
            $( test.eq! true (says "hashes to" (decide (trusting [pub]) ("sha256:" + str.repeat 64 "b") signed)) ),
        test.case "a release signed as another is refused for the one asked for"
            $( test.eq! true (says "an older release" (decide (Policy.set_release "v2" (trusting [pub])) h signed)) ),
        test.case "and accepted for itself"
            $( test.eq! pub (signer_of (decide (Policy.set_release "v1" (trusting [pub])) h signed)) ),
        test.case "a rotation hands trust from the old key to the new"
            $( test.eq! pub2 (signer_of (decide (trusting [pub]) h (file [rotate seed pub2, release other "v1" h]))) ),
        test.case "and retires the old key, even for its own signature"
            $( test.eq! true (says "is not signed by" (decide (trusting [pub]) h (file [rotate seed pub2, release seed "v1" h]))) ),
        test.case "a retired key the lock remembers stays retired without the rotation"
            $( test.eq! true (says "revoked or rotated away"
                                   (decide (Policy.set_retired [pub] (trusting [pub])) h signed)) ),
        test.case "rotations are followed through"
            $( test.eq! pub3 (signer_of (decide (trusting [pub])
                                                h (file [rotate seed pub2, rotate other pub3, release third "v1" h]))) ),
        test.case "a revoked key is refused, and says why"
            $( test.eq! true (says "revoked or rotated away" (decide (trusting [pub]) h (file [release seed "v1" h, revoke seed]))) ),
        test.case "a revocation is reported for remembering"
            $( test.eq! [pub2] (match decide (trusting [pub]) h (file [release seed "v1" h, revoke other]) {
                   Result.ok(v) => Verdict.revoked v, _ => [] }) ),
        test.case "a package nobody named a key for is pinned to its first signer"
            $( test.eq! pub (signer_of (decide (Policy.new ()) h signed)) ),
        test.case "and an unsigned one passes, unless signatures are required"
            $( test.eq! [(), :refused] [signer_of (decide (Policy.new ()) h ()),
                                        signer_of (decide (Policy.set_required true (Policy.new ())) h ())] ),
        test.case "signing again replaces that key's line and keeps the others"
            $( test.eq! 4 (list.length (str.split "\n" (str.trim (file [release seed "v1" h, release other "v1" h,
                                                                        rotate seed pub3, release seed "v2" h])))) ),
        test.case "a build attestation reads back, verifies, and replaces only its own profile's"
            $( {
                   let built p = Built.make h "sha256:c" "sha256:s" "0.1.0+abc" p "sha256:i";
                   let text = file [attest seed "v1" (built "debug"), attest seed "v1" (built "release"),
                                    attest seed "v2" (built "release")];
                   test.eq! [[pub, "v1", built "debug"], [pub, "v2", built "release"]] (builds (statements text))
               } ),
        test.case "a line of the wrong shape does not hide the next"
            $( test.eq! pub (signer_of (decide (trusting [pub]) h ("junk line\n" + signed))) ),
    ];
}
