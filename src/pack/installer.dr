// `install.sh`: the one-line install, for every system with a shell.
//
//     curl -fsSL https://example.org/install.sh | sh
//
// The script works out the system and machine from `uname`, downloads the
// release tarball made for them, checks it against the SHA-256 written into
// the script when it was generated -- so a tarball replaced on the server is
// refused, not installed -- and unpacks it into a prefix: `$PREFIX` if set,
// `/usr/local` as root, `~/.local` otherwise. A tarball already downloaded
// can be named as the first argument instead, and is checked the same way.
//
// It is POSIX sh, with curl or wget, and sha256sum or shasum: what a fresh
// Debian, Fedora, Alpine or macOS has without installing anything.

import std.cli;
import std.file;
import std.io;
import std.list;
import std.str;

import pack.release;
import pack.release.Asset;
import pack.spec;
import pack.spec.Spec;

/// The `case` arm choosing one tarball.
let arm : Asset -> :string;
let arm a = {
    let pattern = if Asset.machine a == "any" { "*" } else { Asset.os a + "-" + Asset.machine a };
    "  " + pattern + ") file=" + cli.shell_quote (Asset.file a) + "; url=" + cli.shell_quote (Asset.url a) + "; sum=" + cli.shell_quote (Asset.sha256 a) + " ;;\n"
};

let script : Spec -> [Asset] -> :string;
let script sp assets = {
    let name = Spec.name sp;
    "#!/bin/sh\n"
    + "# Install " + name + " " + Spec.version sp + ". Generated by ship; make the tarballs again\n"
    + "# and run `mind pack installer` rather than editing this.\n"
    + "#\n#   curl -fsSL <where this script is> | sh\n"
    + "#   curl -fsSL <where this script is> | PREFIX=/opt/" + name + " sh\n"
    + "#   sh install.sh ./" + (match assets { [a, ..] => Asset.file a, [] => "tarball" }) + "     # one already downloaded\n"
    + "#\n# It installs into $PREFIX, or /usr/local as root, or ~/.local, and checks\n"
    + "# the tarball against the SHA-256 written below before unpacking anything.\nset -eu\n\n"
    + "name=" + cli.shell_quote name + "\nversion=" + cli.shell_quote (Spec.version sp) + "\n\n"
    + "fail() { echo \"$name: $*\" >&2; exit 1; }\n\n"
    + "if [ -n \"${PREFIX:-}\" ]; then prefix=$PREFIX\n"
    + "elif [ \"$(id -u)\" = 0 ]; then prefix=/usr/local\n"
    + "else prefix=$HOME/.local\nfi\n\n"
    + "case $(uname -s) in\n  Linux) os=linux ;;\n  Darwin) os=macos ;;\n  *) os=$(uname -s) ;;\nesac\n"
    + "case $(uname -m) in\n  x86_64 | amd64) machine=x86_64 ;;\n  aarch64 | arm64) machine=aarch64 ;;\n  *) machine=$(uname -m) ;;\nesac\n\n"
    + "case $os-$machine in\n" + str.concat_all (map arm assets)
    + (if list.any (fn a -> Asset.machine a == "any") assets { "" }
       else { "  *) fail \"there is no build of $version for $os on $machine\" ;;\n" })
    + "esac\n\n"
    + "tmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT INT TERM\n\n"
    + "if [ $# -gt 0 ]; then\n  cp \"$1\" \"$tmp/$file\" || fail \"cannot read $1\"\n"
    + "elif command -v curl >/dev/null 2>&1; then\n  curl -fsSL \"$url\" -o \"$tmp/$file\" || fail \"cannot download $url\"\n"
    + "elif command -v wget >/dev/null 2>&1; then\n  wget -q \"$url\" -O \"$tmp/$file\" || fail \"cannot download $url\"\n"
    + "else\n  fail \"needs curl or wget to download $url\"\nfi\n\n"
    + "if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum \"$tmp/$file\" | cut -d ' ' -f 1)\n"
    + "elif command -v shasum >/dev/null 2>&1; then got=$(shasum -a 256 \"$tmp/$file\" | cut -d ' ' -f 1)\n"
    + "else fail \"needs sha256sum or shasum to check what it downloaded\"\nfi\n"
    + "[ \"$got\" = \"$sum\" ] || fail \"$file is not the file this script was made for: its SHA-256 is $got, not $sum\"\n\n"
    + "mkdir -p \"$prefix\" || fail \"cannot make $prefix\"\n"
    + "tar -xzf \"$tmp/$file\" -C \"$prefix\" --strip-components=1 || fail \"cannot unpack into $prefix\"\n"
    + "echo \"installed $name $version in $prefix\"\n"
    + "case :$PATH: in\n  *:\"$prefix/bin\":*) ;;\n  *) echo \"add $prefix/bin to your PATH to run it\" ;;\nesac\n"
};

// --- a toolchain -------------------------------------------------------------------------
//
// With `[ship.installer] layout = "toolchain"`, the script installs what
// `mind toolchain` manages (mind/tool/src/toolchain.dr) rather than into a
// prefix: the tarball unpacked whole into `$MINDV2_HOME/toolchains/VERSION`
// (`~/.mindv2` by default) and `current` linked to it. From then on `mind
// toolchain` installs, switches and updates, by moving that one link.
//
// **On `PATH` the standard way**: `dream` and `mind` are links in
// `~/.local/bin` (`$XDG_BIN_HOME`), the directory for a user's own programs,
// which most distributions already put on `PATH` -- Debian's and Ubuntu's
// `~/.profile` when it exists, Fedora's `~/.bashrc`, systemd's user
// environment -- so nothing of the shell's is edited at all. A link works
// because the VM finds its standard library from the binary it really is
// (`/proc/self/exe`, through the link). On Termux they go in `$PREFIX/bin`,
// which is the user's and always on `PATH`. Only where the directory is not
// on `PATH` -- macOS, NixOS by default -- is it put there, rustup's way: an
// `env` file the shell's startup files source, and fish's own `conf.d` for
// fish; `MIND_NO_MODIFY_PATH=1` says what to add instead. A file already
// there that is not one of these links is left alone, and said so.
//
// On a Linux whose programs do not use the usual loader -- NixOS without
// nix-ld, Guix -- the VM is run through the one the system's own shell names,
// as `mind toolchain install` does (`wrap_loader!` there): the published VM
// depends on nothing but the C library, so its loader is all it lacks.

/// The script for the toolchain layout.
let toolchain_script : Spec -> [Asset] -> :string;
let toolchain_script sp assets =
    "#!/bin/sh\n"
    + "# Install the Dream toolchain " + Spec.version sp + ". Generated by `mind pack installer`.\n"
    + "#\n#   curl -fsSL <where this script is> | sh\n"
    + "#   curl -fsSL <where this script is> | MIND_NO_MODIFY_PATH=1 sh   # leave the shell's files alone\n"
    + "#\n# It installs into ${MINDV2_HOME:-~/.mindv2}/toolchains/VERSION, makes it the one in use,\n"
    + "# and checks the tarball against the SHA-256 written below before unpacking anything.\n"
    + "# Afterwards `mind toolchain` installs, switches and updates.\nset -eu\n\n"
    + "version=" + cli.shell_quote (Spec.version sp) + "\n"
    + "home=${MINDV2_HOME:-$HOME/.mindv2}\n\n"
    + "fail() { echo \"dream: $*\" >&2; exit 1; }\n\n"
    + "case $(uname -s) in\n  Linux) os=linux ;;\n  Darwin) os=macos ;;\n  *) os=$(uname -s) ;;\nesac\n"
    + "[ \"$os\" = linux ] && [ \"$(uname -o 2>/dev/null)\" = Android ] && os=android\n"
    + "case $(uname -m) in\n  x86_64 | amd64) machine=x86_64 ;;\n  aarch64 | arm64) machine=aarch64 ;;\n  *) machine=$(uname -m) ;;\nesac\n\n"
    + "case $os-$machine in\n" + str.concat_all (map arm assets)
    + "  *) fail \"there is no toolchain $version for $os on $machine; build it from source: https://github.com/dream-mindv2/toolchain\" ;;\n"
    + "esac\n\n"
    + "dest=$home/toolchains/$version\n"
    + "if [ -x \"$dest/bin/dream\" ]; then\n  echo \"toolchain $version is already installed in $dest\"\nelse\n"
    + "  tmp=$(mktemp -d)\n  trap 'rm -rf \"$tmp\"' EXIT INT TERM\n"
    + "  if command -v curl >/dev/null 2>&1; then\n    curl -fsSL \"$url\" -o \"$tmp/$file\" || fail \"cannot download $url\"\n"
    + "  elif command -v wget >/dev/null 2>&1; then\n    wget -q \"$url\" -O \"$tmp/$file\" || fail \"cannot download $url\"\n"
    + "  else\n    fail \"needs curl or wget to download $url\"\n  fi\n"
    + "  if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum \"$tmp/$file\" | cut -d ' ' -f 1)\n"
    + "  elif command -v shasum >/dev/null 2>&1; then got=$(shasum -a 256 \"$tmp/$file\" | cut -d ' ' -f 1)\n"
    + "  else fail \"needs sha256sum or shasum to check what it downloaded\"\n  fi\n"
    + "  [ \"$got\" = \"$sum\" ] || fail \"$file is not the file this script was made for: its SHA-256 is $got, not $sum\"\n"
    + "  mkdir -p \"$tmp/unpacked\" \"$home/toolchains\"\n"
    + "  tar -xzf \"$tmp/$file\" -C \"$tmp/unpacked\" --strip-components=1 || fail \"cannot unpack $file\"\n"
    + loader_wrap
    + "  mv \"$tmp/unpacked\" \"$dest\"\n"
    + "  echo \"installed toolchain $version in $dest\"\nfi\n\n"
    + "ln -sfn \"toolchains/$version\" \"$home/current\"\n\n"
    + path_setup
    + "echo \"toolchain $version is in use: try 'dream --version' and 'mind toolchain list'\"\n";

/// `dream` and `mind` linked where programs are found; see "On `PATH` the
/// standard way" above.
priv let path_setup =
    "if [ \"$os\" = android ] && [ -n \"${PREFIX:-}\" ]; then bin=$PREFIX/bin; else bin=${XDG_BIN_HOME:-$HOME/.local/bin}; fi\n"
    + "mkdir -p \"$bin\"\n"
    + "for prog in dream mind; do\n"
    + "  if [ -e \"$bin/$prog\" ] && [ ! -L \"$bin/$prog\" ]; then\n"
    + "    echo \"left $bin/$prog alone: it is not a link this installer made; remove it to use the toolchain's\"\n"
    + "  else\n    ln -sfn \"$home/current/bin/$prog\" \"$bin/$prog\"\n  fi\ndone\n\n"
    + "case \":${PATH}:\" in\n  *\":$bin:\"*)\n    echo \"dream and mind are in $bin, which is on your PATH\" ;;\n  *)\n"
    + "    cat > \"$home/env\" <<EOF\n"
    + "# Puts $bin, where the Dream toolchain's programs are, on PATH. Written by its install.sh.\n"
    + "case \":\\\${PATH}:\" in\n  *\":$bin:\"*) ;;\n  *) export PATH=\"$bin:\\\$PATH\" ;;\nesac\nEOF\n"
    + "    line=\". \\\"$home/env\\\"\"\n"
    + "    if [ \"${MIND_NO_MODIFY_PATH:-}\" = 1 ]; then\n"
    + "      echo \"$bin is not on your PATH; add it, or add this to your shell's startup file: $line\"\n    else\n"
    + "      for rc in \"$HOME/.profile\" \"$HOME/.bashrc\" \"$HOME/.zshrc\"; do\n"
    + "        case $rc in\n          *.profile) ;;\n"
    + "          *.bashrc) [ -f \"$rc\" ] || case ${SHELL:-} in */bash) ;; *) continue ;; esac ;;\n"
    + "          *.zshrc) [ -f \"$rc\" ] || case ${SHELL:-} in */zsh) ;; *) continue ;; esac ;;\n        esac\n"
    + "        grep -qsF \"$line\" \"$rc\" || printf '\\n%s\\n' \"$line\" >> \"$rc\"\n      done\n"
    + "      if [ -d \"$HOME/.config/fish\" ] || case ${SHELL:-} in */fish) true ;; *) false ;; esac; then\n"
    + "        mkdir -p \"$HOME/.config/fish/conf.d\"\n"
    + "        printf 'fish_add_path -g %s\\n' \"$bin\" > \"$HOME/.config/fish/conf.d/dream.fish\"\n      fi\n"
    + "      echo \"added $bin to PATH in your shell's startup files; open a new shell, or run: $line\"\n"
    + "    fi ;;\nesac\n";

/// The loader wrap, for a Linux without the usual loader.
priv let loader_wrap =
    "  if [ \"$os\" = linux ]; then\n"
    + "    if [ \"$machine\" = aarch64 ]; then fhs=/lib/ld-linux-aarch64.so.1; else fhs=/lib64/ld-linux-x86-64.so.2; fi\n"
    + "    if [ ! -e \"$fhs\" ] || [ \"${MIND_TOOLCHAIN_WRAP:-}\" = 1 ]; then\n"
    + "      loader=\n"
    + "      for sh in /run/current-system/sw/bin/sh /bin/sh \"$(command -v sh)\"; do\n"
    + "        [ -f \"$sh\" ] || continue\n"
    + "        loader=$(grep -a -o -m 1 '/[[:alnum:]/._+-]*/ld-linux-[[:alnum:]_-]*\\.so\\.[0-9]' \"$sh\" 2>/dev/null | head -n 1) || true\n"
    + "        [ -n \"$loader\" ] && [ -e \"$loader\" ] && break\n        loader=\n      done\n"
    + "      [ -n \"$loader\" ] || fail \"this system has no $fhs, and its own loader could not be found\"\n"
    + "      mv \"$tmp/unpacked/bin/dream\" \"$tmp/unpacked/bin/dream.bin\"\n"
    + "      cat > \"$tmp/unpacked/bin/dream\" <<EOF\n"
    + "#!/bin/sh\n# This system has no FHS dynamic loader (NixOS, Guix), so the VM is run by\n"
    + "# the one its own programs use. Written by install.sh.\n"
    + "here=\\$(cd \"\\$(dirname \"\\$(readlink -f \"\\$0\")\")/..\" && pwd)\n"
    + "export MINDV2_PATH=\"\\${MINDV2_PATH:-\\$here/lib/dream}\"\n"
    + "exec $loader \"\\$here/bin/dream.bin\" \"\\$@\"\nEOF\n"
    + "      chmod 755 \"$tmp/unpacked/bin/dream\"\n"
    + "    fi\n  fi\n";

/// Write `install.sh` into `dest`, answering its path.
let make! : Spec -> :string -> Result :string :string;
let make! sp dest = {
    let? assets = release.find! sp "installer" dest;
    let path = dest + "/install.sh";
    file.write! path (if spec.text sp "installer" "layout" "prefix" == "toolchain" { toolchain_script sp assets } else { script sp assets })
    io.chmod! path 0o755
    ok path
};

when test {
    import std.test;

    let tests = [
        test.case "an arm per tarball"
            $( test.eq! ["  linux-x86_64) file='f'; url='u'; sum='s' ;;\n", "  *) file='f'; url='u'; sum='s' ;;\n"]
                        [arm (Asset.make "linux" "x86_64" "f" "u" "s"), arm (Asset.make "any" "any" "f" "u" "s")] ),
    ];
}
